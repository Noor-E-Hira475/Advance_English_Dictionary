<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Idiom Text -->
        <TextView
            android:id="@+id/tvIdiomText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A piece of cake"
            android:textColor="@color/label_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4sp" />

        <!-- Meaning -->
        <TextView
            android:id="@+id/tvIdiomMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Something that is very easy to do."
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Example -->
        <TextView
            android:id="@+id/tvIdiomExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Example: The test was a piece of cake for me."
            android:textColor="@color/content_color"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/card_divider_color" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Copy Button -->
            <ImageView
                android:id="@+id/btnCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/copy_selector"
                android:layout_marginEnd="32dp"
                android:contentDescription="Copy Idiom"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Share Button -->
            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Share Idiom"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
