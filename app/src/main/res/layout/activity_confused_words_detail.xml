<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Single detail card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="@android:color/darker_gray"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pair title e.g. "Accept / Except" -->
                <TextView
                    android:id="@+id/tvPairTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accept / Except"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/label_color"
                    android:gravity="center"
                    android:paddingBottom="12dp" />

                <!-- Thin divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_divider_color"
                    android:layout_marginBottom="14dp" />

                <!-- Definition 1 -->
                <TextView
                    android:id="@+id/tvDefinition1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- Definition 2 -->
                <TextView
                    android:id="@+id/tvDefinition2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- Definition 3 (only shown for triple-word pairs) -->
                <TextView
                    android:id="@+id/tvDefinition3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- Divider before example -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_divider_color"
                    android:layout_marginBottom="12dp" />

                <!-- Example label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Example:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/label_color"
                    android:layout_marginBottom="6dp" />

                <!-- Example sentence -->
                <TextView
                    android:id="@+id/tvExample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="italic"
                    android:textColor="@color/content_color"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
