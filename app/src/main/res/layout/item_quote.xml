<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Quote Text -->
        <TextView
            android:id="@+id/tvQuoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The best way to predict the future is to create it."
            android:textColor="@color/label_color"
            android:textSize="16sp"
            android:textStyle="italic"
            android:lineSpacingExtra="4sp"
            android:gravity="center_horizontal" />

        <!-- Quote Author -->
        <TextView
            android:id="@+id/tvQuoteAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="— Peter Drucker"
            android:textColor="@color/content_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/card_divider_color" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Copy Button -->
            <ImageView
                android:id="@+id/btnCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/copy_selector"
                android:layout_marginEnd="32dp"
                android:contentDescription="Copy Quote"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Share Button -->
            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Share Quote"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
