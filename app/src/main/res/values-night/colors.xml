<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary / Accent -->
    <color name="primary">#1F2A63</color>          <!-- Dark Indigo -->
    <color name="on_primary">#FFFFFF</color>

    <color name="secondary">#03DAC5</color>        <!-- Teal 200 -->
    <color name="on_secondary">#000000</color>

    <!-- Background / Surface -->
    <color name="background">#121212</color>
    <color name="surface">#1E1E1E</color>
    <color name="on_surface">#FFFFFF</color>

    <!-- Toolbar / AppBar -->
    <color name="toolbar_background">@color/primary</color>
    <color name="toolbar_icon">@color/on_primary</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B3FFFFFF</color> <!-- 70% opacity -->

    <!-- Error / warning -->
    <color name="error">#CF6679</color>
    <color name="on_error">#000000</color>

    <!-- Optional ripple / highlight -->
    <color name="ripple_color">#33FFFFFF</color>

    <!-- Lighter blue so labels stay visible in dark mode -->
    <color name="label_color">#90CAF9</color>

    <!-- Softer light blue for content -->
    <color name="content_color">#BBDEFB</color>

    <!-- Dark divider line -->
    <color name="card_divider_color">#424242</color>

    <!-- Light icon tint -->
    <color name="icon_tint_color">#BDBDBD</color>

</resources>
